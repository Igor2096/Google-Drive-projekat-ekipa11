
# Build stage
FROM golang:1.22 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o notifications-service .

# Run stage
FROM alpine:latest

WORKDIR /app

COPY --from=builder /app/notifications-service .

EXPOSE 8083

CMD ["./notifications-service"]
