# Kopiraj ovaj fajl u .env (cp .env.example .env) i popuni vrednosti.
# .env se NE commit-uje - u njemu su tajne.

# --- API gateway ---
GATEWAY_PORT=8080
# HTTPS izmedju gateway-a i klijenta (2.19). Sertifikat se pravi sam pri
# prvom pokretanju; u browseru jednom otvori https://localhost:8080/health
# i prihvati ga.
TLS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Ogranicenje broja zahteva po korisniku (2.17). Za demonstraciju na odbrani
# privremeno spusti na npr. 1 i 3, pa brzo osvezavaj stranicu -> 429.
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=30

# --- Tajna za potpisivanje JWT tokena (Users servis i gateway) ---
JWT_SECRET=replace-with-a-long-random-secret

# --- Users servis (MongoDB) ---
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=google_drive
DEFAULT_STORAGE_QUOTA_BYTES=1073741824
OTP_TTL_MINUTES=10
TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24
MAGIC_LINK_TTL_MINUTES=15
PASSWORD_CHANGE_MIN_AGE_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_MAX_AGE_DAYS=60
# Za demonstraciju isteka lozinke na odbrani postavi npr. 2 (minuta).
PASSWORD_MAX_AGE_MINUTES=
# Adresa klijentske aplikacije - na nju vode linkovi iz mejlova.
FRONTEND_URL=http://localhost:4200

# --- Mejl (Mailpit: poslati mejlovi se vide na http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@google-drive.local

# --- Files servis (MongoDB + skladiste datoteka) ---
FILES_DB_NAME=files_db
# U bajtovima; 52428800 = 50 MB
MAX_UPLOAD_SIZE=52428800
# Dozvoljeni tipovi datoteka, zarezom odvojeni (2.18). Prazno = podrazumevana
# lista u kodu (tekst, PDF, slike, ZIP/Office, MP3, MP4...).
ALLOWED_FILE_TYPES=

# --- Notifications servis (Cassandra) ---
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
