# API Gateway
GATEWAY_PORT=8080

# Microservices
USERS_SERVICE_PORT=8081
FILES_SERVICE_PORT=8082
NOTIFICATIONS_SERVICE_PORT=8083

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=google_drive
DEFAULT_STORAGE_QUOTA_BYTES=1073741824
OTP_TTL_MINUTES=10
TOKEN_TTL_MINUTES=60
